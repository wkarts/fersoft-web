APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Bahia
TZ=America/Bahia

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

REVERB_SERVER=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Update system configuration
VERSION=5.0.0
VERSION=1.0.0

UPDATE_PROVIDER=github
UPDATE_GITHUB_TOKEN=
UPDATE_GITHUB_USERNAME=
UPDATE_GITHUB_PASSWORD=
UPDATE_GITHUB_ORGANIZATION=
UPDATE_GITHUB_REPOSITORY=
UPDATE_GITHUB_BRANCH=main
UPDATE_SVN_USERNAME=
UPDATE_SVN_PASSWORD=
UPDATE_SVN_REPOSITORY=
UPDATE_SVN_BRANCH=trunk
UPDATE_FILESYSTEM_PATH=
UPDATE_ALLOW_DOWNGRADE=false
UPDATE_AUTO_UPDATE=false
UPDATE_STORAGE_DISK=local
UPDATE_MODE=stable
UPDATE_DEV_BRANCH=develop

UPDATE_BACKUP_ENABLED=true
UPDATE_BACKUP_DRIVER=database   # database|full|none
UPDATE_BACKUP_PATH=
UPDATE_BACKUP_MYSQLDUMP_PATH=
UPDATE_BACKUP_PG_DUMP_PATH=

UPDATE_COMPOSER_ENABLED=true
UPDATE_COMPOSER_ACTION=none     # none|install|update|dump-autoload
UPDATE_COMPOSER_TIMEOUT=600

UPDATE_KEEP_DOWNLOADS=true
# Manter pacotes baixados catalogados localmente
UPDATE_ARCHIVE_PATH=
# Diretório opcional para snapshots e pacotes (deixe vazio para usar storage/app/updates/archives)
UPDATE_ENV_VERSION_KEY=VERSION
#UPDATE_BACKUP_MYSQLDUMP_PATH="C:\\Program Files\\MySQL\\MySQL Server 8.0\\bin\\mysqldump.exe"
UPDATE_BACKUP_MYSQLDUMP_PATH=mysqldump
UPDATE_SKIP_DB_BACKUP=false


# -----------------------------------------------------------------------------
# Cron HTTP protegido - use apenas se não puder configurar cron nativo no servidor
# -----------------------------------------------------------------------------
CRON_MASTER_TOKEN=troque-por-uma-chave-forte
CRON_ALLOWED_IPS=127.0.0.1

# =======================================================
# CRON / LARAVEL SCHEDULER
# =======================================================
# Opções:
# auto     = usa cron HTTP interno apenas quando não detectar cron do servidor ativo.
# always   = permite executar cron HTTP interno mesmo que o cron do servidor esteja ativo.
# disabled = bloqueia execução HTTP; mantém apenas cron real do servidor.
CRON_HTTP_MODE=auto
CRON_MASTER_TOKEN=
CRON_ALLOWED_IPS=
CRON_SERVER_HEARTBEAT_TTL_SECONDS=180
