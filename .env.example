# Update system configuration
VERSION=5.0.0
VERSION=1.0.0

UPDATE_PROVIDER=github
UPDATE_GITHUB_TOKEN=
UPDATE_GITHUB_USERNAME=
UPDATE_GITHUB_PASSWORD=
UPDATE_GITHUB_ORGANIZATION=
UPDATE_GITHUB_REPOSITORY=
UPDATE_GITHUB_BRANCH=main
UPDATE_SVN_USERNAME=
UPDATE_SVN_PASSWORD=
UPDATE_SVN_REPOSITORY=
UPDATE_SVN_BRANCH=trunk
UPDATE_FILESYSTEM_PATH=
UPDATE_ALLOW_DOWNGRADE=false
UPDATE_AUTO_UPDATE=false
UPDATE_STORAGE_DISK=local
UPDATE_MODE=stable
UPDATE_DEV_BRANCH=develop

UPDATE_BACKUP_ENABLED=true
UPDATE_BACKUP_DRIVER=database   # database|full|none
UPDATE_BACKUP_PATH=
UPDATE_BACKUP_MYSQLDUMP_PATH=
UPDATE_BACKUP_PG_DUMP_PATH=

UPDATE_COMPOSER_ENABLED=true
UPDATE_COMPOSER_ACTION=none     # none|install|update|dump-autoload
UPDATE_COMPOSER_TIMEOUT=600

UPDATE_KEEP_DOWNLOADS=true
# Manter pacotes baixados catalogados localmente
UPDATE_ARCHIVE_PATH=
# Diretório opcional para snapshots e pacotes (deixe vazio para usar storage/app/updates/archives)
UPDATE_ENV_VERSION_KEY=VERSION
#UPDATE_BACKUP_MYSQLDUMP_PATH="C:\\Program Files\\MySQL\\MySQL Server 8.0\\bin\\mysqldump.exe"
UPDATE_BACKUP_MYSQLDUMP_PATH=mysqldump
UPDATE_SKIP_DB_BACKUP=false


# -----------------------------------------------------------------------------
# Cron HTTP protegido - use apenas se não puder configurar cron nativo no servidor
# -----------------------------------------------------------------------------
CRON_MASTER_TOKEN=troque-por-uma-chave-forte
CRON_ALLOWED_IPS=127.0.0.1

# =======================================================
# CRON / LARAVEL SCHEDULER
# =======================================================
# Opções:
# auto     = usa cron HTTP interno apenas quando não detectar cron do servidor ativo.
# always   = permite executar cron HTTP interno mesmo que o cron do servidor esteja ativo.
# disabled = bloqueia execução HTTP; mantém apenas cron real do servidor.
CRON_HTTP_MODE=auto
CRON_MASTER_TOKEN=
CRON_ALLOWED_IPS=
CRON_SERVER_HEARTBEAT_TTL_SECONDS=180

# Pesagem ADP - snapshots
# public_path grava em public/pesagem_ticket_imagens/empresa_id/pesagem_id/ticket_id
# minio/s3 grava no bucket configurado abaixo
PESAGEM_SNAPSHOT_DISK=public_path
PESAGEM_SNAPSHOT_BASE_PATH=pesagem_ticket_imagens
PESAGEM_SNAPSHOT_VISIBILITY=public

# MinIO opcional para snapshots da pesagem
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_DEFAULT_REGION=us-east-1
MINIO_BUCKET=
MINIO_ENDPOINT=
MINIO_URL=
MINIO_USE_PATH_STYLE_ENDPOINT=true

# ADP - armazenamento do token global independente da APP_KEY do Laravel.
# Use "plain" para não quebrar quando executar php artisan key:generate.
# Use "custom_encrypted" somente se ADP_GLOBAL_TOKEN_SECRET for fixo e nunca for regenerado.
ADP_GLOBAL_TOKEN_STORAGE=custom_encrypted
ADP_GLOBAL_TOKEN_SECRET=
# Gere uma chave estável com: php artisan adp:generate-token-secret --write

# Downloads do All Driver Platform Desktop exibidos no menu Dispositivos A.D.P. > A.D.P.
ADP_DOWNLOAD_WINDOWS_X86=/adp/adp-windows-x86.7z
ADP_DOWNLOAD_WINDOWS_X64=/adp/adp-windows-x64.7z
ADP_DOWNLOAD_MACOS=/adp/adp-macos.7z
ADP_DOWNLOAD_LINUX_DEBIAN=/adp/adp-linux-debian.7z

# =======================================================
# REFORMA TRIBUTÁRIA - CONTROLE POR AMBIENTE E REGIME
# =======================================================
# Estas variáveis controlam se a RT (IBS/CBS/IS) deve ser aplicada na emissão fiscal.
#
# Formato: lista CSV (separada por vírgula) com os códigos de regime permitidos.
# Exemplo: 1,2
#
# Códigos de regime de apuração (tributacaos.regime):
# 0 = Simples Nacional
# 1 = Regime Normal (ex.: Lucro Real / Lucro Presumido / apuração normal)
# 2 = MEI
#
# PRODUÇÃO (config_notas.ambiente = 1)
# Default recomendado: somente Regime Normal.
# Para incluir outros regimes futuramente, adicione na lista.
REFORMA_TRIBUTARIA_REGIMES_PRODUCAO=1
# Exemplos:
# REFORMA_TRIBUTARIA_REGIMES_PRODUCAO=1
# REFORMA_TRIBUTARIA_REGIMES_PRODUCAO=0,1,2
# REFORMA_TRIBUTARIA_REGIMES_PRODUCAO=   (vazio = desativa RT em produção)

# HOMOLOGAÇÃO (config_notas.ambiente = 2)
# Default recomendado: permitir testes em todos os regimes atuais.
# Você pode ativar/desativar por regime livremente para cenários de teste.
REFORMA_TRIBUTARIA_REGIMES_HOMOLOGACAO=0,1,2
# Exemplos:
# REFORMA_TRIBUTARIA_REGIMES_HOMOLOGACAO=0,1,2
# REFORMA_TRIBUTARIA_REGIMES_HOMOLOGACAO=1
# REFORMA_TRIBUTARIA_REGIMES_HOMOLOGACAO=   (vazio = desativa RT em homologação)
# REFORMA_TRIBUTARIA_REGIMES_HOMOLOGACAO=0,1,2,xxxxxxx
# Obs.: valores inválidos (ex.: xxxxxxx) são ignorados no parser.

# =======================================================
# TRACCAR
# =======================================================
# Configuração global/fallback. O cadastro TraccarConfig do tenant,
# quando preenchido, continua tendo prioridade campo a campo.
TRACCAR_BASE_URL=https://traccar.seudominio.com.br
TRACCAR_SOCKET_URL=wss://traccar.seudominio.com.br/api/socket
TRACCAR_USERNAME=
TRACCAR_PASSWORD=
TRACCAR_TOKEN=

# Event Forwarding / Webhook
# Configure o mesmo segredo no event.forward.header do Traccar.
TRACCAR_WEBHOOK_SECRET=
TRACCAR_WEBHOOK_HEADER=X-Traccar-Webhook-Secret
TRACCAR_WEBHOOK_MAX_ATTEMPTS=20
TRACCAR_WEBHOOK_NO_MOVEMENT_MAX_ATTEMPTS=5
TRACCAR_WEBHOOK_RETRY_SECONDS=60
TRACCAR_WEBHOOK_PROCESSING_LOCK_SECONDS=120
TRACCAR_WEBHOOK_RETENTION_DAYS=30
TRACCAR_WEBHOOK_RECONCILE_HOURS=48


# Connect|API - comunicacao WhatsApp padrao do FERSOFT WEB
CONNECT_API_BASE_URL=
CONNECT_API_BOOTSTRAP_KEY=
CONNECT_API_TIMEOUT=30
CONNECT_API_CONNECT_TIMEOUT=10
CONNECT_API_DDI=55
CONNECT_API_DDD=75
CONNECT_API_INSTANCE_PREFIX=

CONNECT_API_WHATSAPP_MODAL_HINTBUTTON="Enviar WhatsApp"
CONNECT_API_WHATSAPP_MODAL_TITLE="Enviar WhatsApp"
CONNECT_API_WHATSAPP_SEND_BUTTON_TEXT="Enviar"
CONNECT_API_WHATSAPP_MODAL_HINTFOOTER="Envio realizado pela Connect|API configurada para esta empresa."
