{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "argws/laravel-updater": "^0.1.113",
        "cloud-dfe/sdk-php": "^v0.4.4",
        "comtele/comtele_sdk": "^1.1.6",
        "doctrine/dbal": "^4.2",
        "dompdf/dompdf": "^v3.1.0",
        "eduardokum/laravel-boleto": "^0.11.1",
        "guzzlehttp/guzzle": "^7.9.2",
        "helidalto/nfse-ssa": "^2.2",
        "laravel/framework": "^v11.38.2",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^v4.0.7",
        "laravel/tinker": "^v2.10.0",
        "maatwebsite/excel": "^3.1.62",
        "mercadopago/dx-php": "^3.0.8",
        "mr-wolf-gb/traccar": "^1.0",
        "nfephp-org/posprint": "^v0.1.3",
        "nfephp-org/sped-common": "^v5.1.14",
        "nfephp-org/sped-cte": "^v5.0.0",
        "nfephp-org/sped-da": "^v1.1.6",
        "nfephp-org/sped-efd": "dev-master",
        "nfephp-org/sped-ibpt": "^v2.0.1",
        "nfephp-org/sped-mdfe": "^v4.1.1",
        "nfephp-org/sped-nfe": "^v5.1.27",
        "phpclasses/php_serial": "^1.10",
        "phpmailer/phpmailer": "^v6.9.3",
        "picqer/php-barcode-generator": "^v3.2.0",
        "pragmarx/google2fa-laravel": "^2.3",
        "robrichards/xmlseclibs": "^3.1.3",
        "setasign/fpdi": "^v2.6.2",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-backup": "^9.2.2",
        "tecnickcom/tcpdf": "^6.8.0",
        "tiendanube/php-sdk": "^1.1",
        "webmaniabr/nfse": "^2.6"
    },
    "require-dev": {
        "fakerphp/faker": "^v1.24.1",
        "kitloong/laravel-migrations-generator": "^7.0.6",
        "laravel/pint": "^v1.20.0",
        "laravel/sail": "^v1.40.0",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.5.0",
        "phpunit/phpunit": "^11.5.3",
        "spatie/laravel-ignition": "^2.9.0",
        "zoon/puphpeteer": "^v2.2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "psr-0": {
            "stock": "app/Helpers/StockMove.php"
        },
        "files": [
            "app/Helpers/User.php",
            "app/Helpers/Menu.php",
            "app/Helpers/BoletoHelper.php",
            "app/Helpers/ProdutoGrade.php",
            "app/Helpers/PedidoEcommerceHelper.php",
            "app/Helpers/UserOtpHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/phpclasses_php_serial",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "composer",
            "url": "https://www.phpclasses.org/"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}