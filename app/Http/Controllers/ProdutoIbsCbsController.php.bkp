<?php

namespace App\Http\Controllers;

use App\Services\ProdutoIbsCbsUpdater;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;

class ProdutoIbsCbsController extends Controller
{
    /**
     * POST /produtos/ibs-cbs/atualizar
     *
     * Body JSON:
     *  - only_missing: boolean (default true)
     *  - empresa_id: int|null (opcional; se não vier tenta Auth/session)
     *  - chunk: int (default 500)
     */
    public function atualizar(Request $request, ProdutoIbsCbsUpdater $updater)
    {
        $payload = $request->validate([
            'only_missing' => ['sometimes'],
            'empresa_id'   => ['nullable', 'integer'],
            'chunk'        => ['nullable', 'integer', 'min:50', 'max:5000'],
        ]);

        $onlyMissing = array_key_exists('only_missing', $payload)
            ? filter_var($payload['only_missing'], FILTER_VALIDATE_BOOL, FILTER_NULL_ON_FAILURE)
            : true;
        if ($onlyMissing === null) $onlyMissing = true;

        $empresaId = $payload['empresa_id'] ?? null;
        if ($empresaId === null) {
            $empresaId = Auth::check() ? (Auth::user()->empresa_id ?? null) : null;
            if ($empresaId === null) $empresaId = session('empresa_id');
        }

        $chunk = (int)($payload['chunk'] ?? 500);

        $result = $updater->exec($empresaId, $onlyMissing, $chunk);

        return response()->json([
            'ok'     => true,
            'result' => $result,
        ]);
    }
}
